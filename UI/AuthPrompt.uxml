<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="AuthPrompt.uss" />

    <ui:VisualElement name="auth-overlay" class="auth-overlay">
        <ui:VisualElement class="auth-card">

            <ui:VisualElement class="auth-header">
                <ui:Label class="auth-title" text="Sign In" />
            </ui:VisualElement>

            <!-- PAGE: options -->
            <ui:VisualElement name="page-options" class="auth-page">

                <ui:Button name="btn-email" class="auth-btn auth-btn--primary" text="">
                    <ui:VisualElement class="auth-btn-icon auth-btn-icon--email">
                        <ui:Label class="auth-btn-icon-glyph" text="@" />
                    </ui:VisualElement>
                    <ui:Label class="auth-btn-label" text="Continue with Email" />
                    <ui:VisualElement class="auth-btn-chevron">
                        <ui:Label class="auth-btn-chevron-glyph" text=">" />
                    </ui:VisualElement>
                </ui:Button>

                <ui:VisualElement class="auth-divider">
                    <ui:VisualElement class="auth-divider-line" />
                    <ui:Label class="auth-divider-text" text="OR CONNECT A WALLET" />
                    <ui:VisualElement class="auth-divider-line" />
                </ui:VisualElement>

                <ui:Button name="btn-algorand" class="auth-btn auth-btn--wallet" text="">
                    <ui:VisualElement class="auth-btn-icon auth-btn-icon--algo">
                        <ui:Label class="auth-btn-icon-glyph" text="A" />
                    </ui:VisualElement>
                    <ui:Label class="auth-btn-label" text="Algorand" />
                    <ui:VisualElement class="auth-btn-chevron">
                        <ui:Label class="auth-btn-chevron-glyph" text=">" />
                    </ui:VisualElement>
                </ui:Button>

                <ui:Button name="btn-metamask" class="auth-btn auth-btn--wallet" text="">
                    <ui:VisualElement class="auth-btn-icon auth-btn-icon--evm">
                        <ui:Label class="auth-btn-icon-glyph" text="X" />
                    </ui:VisualElement>
                    <ui:VisualElement class="auth-btn-body">
                        <ui:Label class="auth-btn-label" text="X-Chain" />
                        <ui:Label class="auth-btn-sub" text="Any EVM wallet" />
                    </ui:VisualElement>
                    <ui:VisualElement class="auth-btn-chevron">
                        <ui:Label class="auth-btn-chevron-glyph" text=">" />
                    </ui:VisualElement>
                </ui:Button>

            </ui:VisualElement>

            <!-- PAGE: Algorand wallet picker -->
            <ui:VisualElement name="page-algo-wallets" class="auth-page">

                <ui:VisualElement class="auth-page-nav">
                    <ui:Button name="btn-back-from-wallets" class="auth-back-btn" text="&lt;" />
                    <ui:Label class="auth-page-heading" text="Choose Wallet" />
                </ui:VisualElement>

                <ui:Button name="btn-pera" class="auth-btn auth-btn--wallet" text="">
                    <ui:VisualElement class="auth-btn-icon auth-btn-icon--pera">
                        <ui:Label class="auth-btn-icon-glyph" text="P" />
                    </ui:VisualElement>
                    <ui:Label class="auth-btn-label" text="Pera Wallet" />
                    <ui:VisualElement class="auth-btn-chevron">
                        <ui:Label class="auth-btn-chevron-glyph" text=">" />
                    </ui:VisualElement>
                </ui:Button>

                <ui:Button name="btn-defly" class="auth-btn auth-btn--wallet" text="">
                    <ui:VisualElement class="auth-btn-icon auth-btn-icon--defly">
                        <ui:Label class="auth-btn-icon-glyph" text="D" />
                    </ui:VisualElement>
                    <ui:Label class="auth-btn-label" text="Defly Wallet" />
                    <ui:VisualElement class="auth-btn-chevron">
                        <ui:Label class="auth-btn-chevron-glyph" text=">" />
                    </ui:VisualElement>
                </ui:Button>


            </ui:VisualElement>

            <!-- PAGE: EVM wallet picker (EIP-6963 discovered wallets) -->
            <ui:VisualElement name="page-evm-wallets" class="auth-page">

                <ui:VisualElement class="auth-page-nav">
                    <ui:Button name="btn-back-from-evm" class="auth-back-btn" text="&lt;" />
                    <ui:Label name="lbl-evm-heading" class="auth-page-heading" text="Choose Wallet" />
                </ui:VisualElement>

                <!-- STATE: loading (discovery in flight) -->
                <ui:VisualElement name="evm-state-loading" class="evm-state evm-state--center">
                    <ui:VisualElement class="auth-qr-spinner evm-spinner" />
                    <ui:Label class="evm-loading-text" text="Looking for wallets..." />
                </ui:VisualElement>

                <!-- STATE: no wallet detected -->
                <ui:VisualElement name="evm-state-empty" class="evm-state evm-state--center">
                    <ui:Label class="evm-empty-title" text="No EVM wallet detected." />
                    <ui:Button name="btn-evm-find-wallet" class="auth-cta-btn evm-find-btn" text="Find a Wallet" />
                    <ui:Label class="evm-empty-hint" text="On a phone? Open this page in your wallet's built-in browser." />
                </ui:VisualElement>

                <!-- STATE: wallet list (rows are built in code, one per discovered wallet) -->
                <ui:ScrollView name="evm-wallet-list" class="evm-state evm-wallet-list" />

                <!-- STATE: connecting to one wallet (also hosts the error states) -->
                <ui:VisualElement name="evm-state-connecting" class="evm-state evm-state--center">
                    <ui:VisualElement name="evm-connect-icon" class="evm-connect-icon">
                        <ui:Label name="lbl-evm-connect-glyph" class="evm-connect-glyph" text="" />
                    </ui:VisualElement>
                    <ui:Label name="lbl-evm-connect-title" class="evm-connect-title" text="Requesting connection..." />
                    <ui:Label name="lbl-evm-connect-body" class="evm-connect-body" text="" />
                    <ui:VisualElement name="evm-connect-dots" class="auth-step2-dots">
                        <ui:VisualElement name="evm-dot-1" class="auth-step2-dot" />
                        <ui:VisualElement name="evm-dot-2" class="auth-step2-dot" />
                        <ui:VisualElement name="evm-dot-3" class="auth-step2-dot" />
                    </ui:VisualElement>
                    <ui:Button name="btn-evm-retry" class="auth-step2-resend-btn evm-retry-btn" text="TRY AGAIN" />
                    <ui:Button name="btn-evm-cancel" class="auth-link-btn auth-step2-cancel-btn" text="CANCEL" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- PAGE: OTP -->
            <ui:VisualElement name="page-otp" class="auth-page">

                <ui:VisualElement name="otp-step1" class="auth-step">
                    <ui:VisualElement class="auth-page-nav">
                        <ui:Button name="btn-back-options" class="auth-back-btn" text="&lt;" />
                        <ui:Label class="auth-page-heading" text="Enter your email" />
                    </ui:VisualElement>
                    <ui:Label class="auth-field-label" text="EMAIL ADDRESS" />
                    <ui:TextField name="input-email" class="auth-input" keyboard-type="EmailAddress" />
                    <ui:Button name="btn-send-code" class="auth-cta-btn" text="Send Sign-In Code" />
                </ui:VisualElement>

                <ui:VisualElement name="otp-step2" class="auth-step">
                    <ui:Label class="auth-page-heading auth-page-heading--standalone" text="Check your inbox" />
                    <ui:Label name="lbl-sent-to" class="auth-sent-hint" text="" />
                    <ui:Label class="auth-field-label" text="SIGN-IN CODE" />
                    <ui:TextField name="input-otp" class="auth-input auth-input--code" max-length="6" keyboard-type="NumberPad" />
                    <ui:Button name="btn-verify" class="auth-cta-btn" text="Verify and Continue" />
                    <ui:Button name="btn-resend-code" class="auth-link-btn" text="Resend code (60s)" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- PAGE: QR wallet connect -->
            <ui:VisualElement name="page-qr" class="auth-page auth-page--center">

                <ui:VisualElement class="auth-page-nav">
                    <ui:Button name="btn-cancel-connect" class="auth-back-btn" text="&lt;" />
                    <ui:Label name="lbl-qr-provider" class="auth-page-heading" text="Scan with Pera Wallet" />
                </ui:VisualElement>

                <ui:VisualElement class="auth-qr-outer">
                    <ui:VisualElement class="auth-qr-frame">
                        <ui:VisualElement name="img-qr" class="auth-qr-image" />
                        <ui:VisualElement name="qr-loading" class="auth-qr-loading-wrap">
                            <ui:VisualElement class="auth-qr-spinner" />
                            <ui:Label class="auth-qr-loading-text" text="Generating..." />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label class="auth-qr-hint" text="Open your wallet app and scan the code to connect" />
                <ui:Label class="auth-qr-steps-hint" text="Signing in takes 2 quick approvals in your wallet." />
                <ui:Button name="btn-open-wallet" class="auth-pill-btn" text="OPEN IN WALLET APP" style="display: none;" />
                <ui:Button name="btn-copy-wc-link" class="auth-pill-btn" text="Copy Link" />
            </ui:VisualElement>

            <!-- PAGE: waiting for the sign-in approval (wallet approval 2 of 2) -->
            <ui:VisualElement name="page-step2" class="auth-page auth-page--center">
                <ui:Label class="auth-step2-badge" text="STEP 2 OF 2" />
                <ui:Label class="auth-step2-title" text="One more step!" />
                <ui:Label name="lbl-step2-body" class="auth-step2-body" text="Approve the SIGN-IN REQUEST in your wallet app - it's a free signature, nothing leaves your wallet." />
                <ui:VisualElement class="auth-step2-dots">
                    <ui:VisualElement name="step2-dot-1" class="auth-step2-dot" />
                    <ui:VisualElement name="step2-dot-2" class="auth-step2-dot" />
                    <ui:VisualElement name="step2-dot-3" class="auth-step2-dot" />
                </ui:VisualElement>
                <ui:Label class="auth-step2-hint" text="Check your phone - the request is waiting in the app." />
                <ui:Label name="lbl-step2-resend-hint" class="auth-step2-resend-hint" text="Request expired or nothing in your app? Resend it." />
                <ui:Button name="btn-step2-resend" class="auth-step2-resend-btn" text="RESEND REQUEST" />
                <ui:Button name="btn-step2-cancel" class="auth-link-btn auth-step2-cancel-btn" text="CANCEL" />
            </ui:VisualElement>

            <!-- Wallet address change warning -->
            <ui:VisualElement name="wallet-warning-banner" class="auth-wallet-warning">
                <ui:Label name="lbl-wallet-warning" class="auth-wallet-warning-text" text="" />
            </ui:VisualElement>

            <!-- Status / error -->
            <ui:Label name="lbl-auth-status" class="auth-status" text="" />

            <!-- Close button (last child so it renders above all pages) -->
            <ui:Button name="btn-close" class="auth-close-btn" text="&#215;" />

        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
