/* =========================================================================
   BlockmakerTheme.uss
   SDK Design Tokens
   Import in every screen USS:  @import url("BlockmakerTheme.uss");
   Generic dark/purple theme. No game-specific references.
   Font is intentionally left unset so each game inherits its own.
   ========================================================================= */

:root {
    /* Brand */
    --bm-primary:          #6D28D9;
    --bm-primary-hover:    #7C3AED;
    --bm-primary-active:   #5B21B6;
    --bm-accent:           #A78BFA;
    --bm-accent-dim:       rgba(167, 139, 250, 0.35);

    /* Backgrounds */
    --bm-bg:               #0A0A12;
    --bm-bg-card:          #0D0D14;
    --bm-panel:            #0D0D14;
    --bm-surface:          #141420;
    --bm-surface-2:        #1C1C2A;
    --bm-surface-hover:    #222236;

    /* Text */
    --bm-text:             #EEEEF6;
    --bm-text-secondary:   rgba(238, 238, 246, 0.65);
    --bm-text-muted:       rgba(238, 238, 246, 0.40);
    --bm-text-dim:         rgba(238, 238, 246, 0.45);

    /* Borders */
    --bm-border:           rgba(255, 255, 255, 0.06);
    --bm-border-bright:    rgba(255, 255, 255, 0.12);
    --bm-border-primary:   rgba(109, 40, 217, 0.55);
    --bm-border-accent:    rgba(167, 139, 250, 0.25);

    /* Provider colors */
    --bm-pera:             #FED700;
    --bm-defly:            #38BDF8;
    --bm-evm:              #FBBF24;

    /* Semantic */
    --bm-error:            #F87171;
    --bm-success:          #34D399;
    --bm-warning:          #FBBF24;

    /* Overlay */
    --bm-backdrop:         rgba(4, 4, 10, 0.78);

    /* Radius */
    --bm-radius-sm:        8px;
    --bm-radius:           12px;
    --bm-radius-lg:        16px;
    --bm-radius-xl:        20px;
    --bm-radius-full:      999px;

    /* Spacing */
    --bm-space-xs:         4px;
    --bm-space-sm:         8px;
    --bm-space-md:         16px;
    --bm-space-lg:         24px;
    --bm-space-xl:         32px;
    --bm-space-2xl:        48px;
}

/* =========================================================================
   Shared crisp geometry (font-free, WebGL-safe)
   Imported by every modal USS via @import url("BlockmakerTheme.uss").
   ========================================================================= */

/* ── Chevron: an L-corner (right + bottom borders) rotated to a caret ───── */
/* transform-origin defaults to center; if a chevron points the wrong way in
   a build, negate its rotate angle (the two variants below are mirror pairs). */
.auth-chevron {
    width:                      9px;
    height:                     9px;
    border-top-width:           0;
    border-left-width:          0;
    border-right-width:         2.75px;
    border-bottom-width:        2.75px;
    border-right-color:         rgba(255, 255, 255, 0.10);
    border-bottom-color:        rgba(255, 255, 255, 0.10);
    rotate:                     -45deg;   /* points right › */
    transition-property:        border-right-color, border-bottom-color, translate;
    transition-duration:        0.18s;
    transition-timing-function: ease-in-out;
}

.auth-chevron--left {
    rotate: 135deg;   /* points left ‹ */
}

/* ── Close cross: two bars crossing at center inside a 14x14 box ────────── */
.auth-close-x {
    width:  14px;
    height: 14px;
}

.auth-close-bar {
    position:                   absolute;
    top:                        6px;   /* (14 - 2) / 2 → vertically centered */
    left:                       0;
    right:                      0;
    height:                     2px;
    border-top-left-radius:     1px;
    border-top-right-radius:    1px;
    border-bottom-left-radius:  1px;
    border-bottom-right-radius: 1px;
    background-color:           rgba(238, 238, 246, 0.55);
    transition-property:        background-color;
    transition-duration:        0.15s;
    transition-timing-function: ease-in-out;
}

.auth-close-bar--a { rotate: 45deg; }
.auth-close-bar--b { rotate: -45deg; }
