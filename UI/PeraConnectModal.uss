/* =========================================================================
   PeraConnectModal.uss
   Pera wallet connection modal — dark card, large logo, big QR.
   ========================================================================= */

@import url("BlockmakerTheme.uss");


/* ── Overlay ─────────────────────────────────────────────────────────── */

.pera-overlay {
    position:        absolute;
    left:            0;
    top:             0;
    right:           0;
    bottom:          0;
    align-items:     center;
    justify-content: center;
}

.pera-backdrop {
    position:         absolute;
    left:             0;
    top:              0;
    right:            0;
    bottom:           0;
    background-color: rgba(4, 4, 10, 0.78);
}

.pera-hidden {
    display: none;
}


/* ── Card ────────────────────────────────────────────────────────────── */

.pera-card {
    width:                      92%;
    max-width:                  528px;
    background-color:           #141418;
    border-top-left-radius:     22px;
    border-top-right-radius:    22px;
    border-bottom-left-radius:  22px;
    border-bottom-right-radius: 22px;
    border-top-width:           1px;
    border-left-width:          1px;
    border-right-width:         1px;
    border-bottom-width:        1px;
    border-top-color:           rgba(255, 255, 255, 0.07);
    border-left-color:          rgba(255, 255, 255, 0.04);
    border-right-color:         rgba(255, 255, 255, 0.04);
    border-bottom-color:        rgba(0, 0, 0, 0.40);
    padding-top:                31px;
    padding-bottom:             31px;
    padding-left:               35px;
    padding-right:              35px;
    align-items:                center;
}


/* ── Back button (top-left corner) ───────────────────────────────────── */

.pera-back-btn {
    position:            absolute;
    left:                22px;
    top:                 22px;
    background-color:    rgba(255, 255, 255, 0.06);
    border-top-width:    1px;
    border-left-width:   1px;
    border-right-width:  1px;
    border-bottom-width: 1px;
    border-top-color:    rgba(255, 255, 255, 0.08);
    border-left-color:   rgba(255, 255, 255, 0.06);
    border-right-color:  rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.03);
    border-top-left-radius:     9px;
    border-top-right-radius:    9px;
    border-bottom-left-radius:  9px;
    border-bottom-right-radius: 9px;
    color:               rgba(240, 240, 248, 0.50);
    font-size:           18px;
    width:               40px;
    height:              40px;
    padding-left:        0;
    padding-right:       0;
    padding-top:         0;
    padding-bottom:      0;
    cursor:              link;
    transition-property: background-color, color;
    transition-duration: 120ms;
}

.pera-back-btn:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color:            rgba(240, 240, 248, 0.85);
}

.pera-back-btn:active {
    background-color: rgba(255, 255, 255, 0.04);
    color:            rgba(240, 240, 248, 0.35);
}


.pera-close-btn {
    position:            absolute;
    right:               16px;
    top:                 16px;
    width:               32px;
    height:              32px;
    border-top-left-radius:     8px;
    border-top-right-radius:    8px;
    border-bottom-left-radius:  8px;
    border-bottom-right-radius: 8px;
    border-top-width:    0;
    border-left-width:   0;
    border-right-width:  0;
    border-bottom-width: 0;
    background-color:    transparent;
    color:               rgba(255, 255, 255, 0.25);
    font-size:           18px;
    padding-left:        0;
    padding-right:       0;
    padding-top:         0;
    padding-bottom:      0;
    align-items:         center;
    justify-content:     center;
    cursor:              link;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.pera-close-btn:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color:            rgba(255, 255, 255, 0.60);
}

.pera-close-btn:active {
    background-color: rgba(255, 255, 255, 0.04);
    color:            rgba(240, 240, 248, 0.35);
}


/* ── Pera logo (large, centered) ─────────────────────────────────────── */

.pera-logo {
    width:                        88px;
    height:                       88px;
    margin-top:                   13px;
    margin-bottom:                18px;
    -unity-background-scale-mode: scale-to-fit;
}


/* ── Title ───────────────────────────────────────────────────────────── */

.pera-title {
    font-size:         20px;
    -unity-font-style: bold;
    color:             rgba(240, 240, 248, 0.90);
    margin-bottom:     24px;
    letter-spacing:    -0.3px;
    -unity-text-align: upper-center;
}


/* ── QR code ─────────────────────────────────────────────────────────── */

.pera-qr-frame {
    width:                      352px;
    height:                     352px;
    background-color:           #FFFFFF;
    border-top-left-radius:     15px;
    border-top-right-radius:    15px;
    border-bottom-left-radius:  15px;
    border-bottom-right-radius: 15px;
    padding-top:                9px;
    padding-bottom:             9px;
    padding-left:               9px;
    padding-right:              9px;
    align-items:                center;
    justify-content:            center;
    margin-bottom:              15px;
}

.pera-qr {
    width:                        334px;
    height:                       334px;
    -unity-background-scale-mode: scale-to-fit;
}

.pera-qr-frame-sm {
    width:  264px;
    height: 264px;
}

.pera-qr-sm {
    width:  246px;
    height: 246px;
}


/* ── Status ──────────────────────────────────────────────────────────── */

.pera-status {
    font-size:         14px;
    color:             rgba(240, 240, 248, 0.38);
    margin-bottom:     20px;
    -unity-text-align: upper-center;
}


.pera-steps-hint {
    font-size:         13px;
    color:             rgba(240, 240, 248, 0.45);
    white-space:       normal;
    -unity-text-align: upper-center;
    margin-top:        -8px;
    margin-bottom:     18px;
}


/* ── Step 2 of 2 — waiting for the wallet sign-in approval ───────────── */

.pera-step2 {
    width:          100%;
    align-items:    center;
    padding-top:    4px;
    padding-bottom: 10px;
}

.pera-step2-badge {
    font-size:                  12px;
    letter-spacing:             3px;
    -unity-font-style:          bold;
    -unity-text-align:          middle-center;
    color:                      rgba(240, 240, 248, 0.65);
    background-color:           rgba(255, 255, 255, 0.05);
    border-top-width:           1px;
    border-right-width:         1px;
    border-bottom-width:        1px;
    border-left-width:          1px;
    border-color:               rgba(255, 255, 255, 0.12);
    border-top-left-radius:     14px;
    border-top-right-radius:    14px;
    border-bottom-left-radius:  14px;
    border-bottom-right-radius: 14px;
    padding-top:                6px;
    padding-bottom:             6px;
    padding-left:               16px;
    padding-right:              16px;
    margin-bottom:              20px;
}

.pera-step2-body {
    font-size:         16px;
    color:             rgba(240, 240, 248, 0.88);
    white-space:       normal;
    -unity-text-align: middle-center;
    max-width:         380px;
    margin-bottom:     24px;
}

.pera-step2-dots {
    flex-direction:  row;
    justify-content: center;
    align-items:     center;
    height:          24px;
    margin-bottom:   18px;
}

.pera-step2-dot {
    width:                      12px;
    height:                     12px;
    border-top-left-radius:     6px;
    border-top-right-radius:    6px;
    border-bottom-left-radius:  6px;
    border-bottom-right-radius: 6px;
    margin-left:                6px;
    margin-right:               6px;
    background-color:           rgba(255, 255, 255, 0.14);
    transition-property:        background-color, scale;
    transition-duration:        0.25s;
    transition-timing-function: ease-in-out;
}

.pera-step2-dot--on {
    background-color: #FFFFFF;
    scale:            1.4;
}

.pera-step2-hint {
    font-size:         13px;
    color:             rgba(240, 240, 248, 0.40);
    white-space:       normal;
    -unity-text-align: middle-center;
}

/* ── Step 2 recovery controls (resend / cancel) ──────────────────────── */

.pera-step2-resend-hint {
    font-size:         12px;
    color:             rgba(240, 240, 248, 0.30);
    white-space:       normal;
    -unity-text-align: middle-center;
    margin-top:        18px;
    margin-bottom:     10px;
}

/* Chained selector: must out-rank .pera-store-btn (defined later in this file,
   and later rules win specificity ties in UITK). Solid white PRIMARY action —
   the one thing to do on this screen should look like it. */
.pera-store-btn.pera-step2-resend-btn {
    align-self:          center;
    min-width:           260px;
    margin-left:         0;
    margin-right:        0;
    margin-bottom:       4px;
    background-color:    #F2F2F6;
    border-top-color:    rgba(255, 255, 255, 0.90);
    border-left-color:   rgba(255, 255, 255, 0.70);
    border-right-color:  rgba(255, 255, 255, 0.70);
    border-bottom-color: rgba(200, 200, 210, 0.60);
    color:               #101014;
}

.pera-store-btn.pera-step2-resend-btn:hover {
    background-color:    #FFFFFF;
    border-top-color:    #FFFFFF;
    border-left-color:   #FFFFFF;
    border-right-color:  #FFFFFF;
    border-bottom-color: rgba(200, 200, 210, 0.60);
    color:               #101014;
}

.pera-store-btn.pera-step2-resend-btn:active {
    background-color: rgba(242, 242, 246, 0.80);
    color:            rgba(16, 16, 20, 0.70);
}

.pera-store-btn.pera-step2-resend-btn:disabled {
    opacity: 0.5;
}

.pera-step2-cancel-btn {
    background-color:    rgba(0, 0, 0, 0);
    border-top-width:    0;
    border-left-width:   0;
    border-right-width:  0;
    border-bottom-width: 0;
    color:               rgba(240, 240, 248, 0.35);
    font-size:           13px;
    -unity-text-align:   middle-center;
    height:              34px;
    min-width:           260px;
    margin-top:          4px;
    padding-top:         0;
    padding-bottom:      0;
    padding-left:        0;
    padding-right:       0;
    cursor:              link;
    transition-property: color;
    transition-duration: 120ms;
}

.pera-step2-cancel-btn:hover {
    color: rgba(240, 240, 248, 0.70);
}

.pera-step2-cancel-btn:active {
    color: rgba(240, 240, 248, 0.25);
}


/* ── Divider ─────────────────────────────────────────────────────────── */

.pera-divider {
    width:            100%;
    height:           1px;
    background-color: rgba(255, 255, 255, 0.06);
    margin-bottom:    15px;
}


/* ── Footer ──────────────────────────────────────────────────────────── */

.pera-footer {
    flex-direction:  row;
    align-items:     center;
    justify-content: center;
}

.pera-footer-hint {
    font-size:    14px;
    color:        rgba(240, 240, 248, 0.30);
    margin-right: 7px;
}

.pera-footer-link {
    background-color:    rgba(0, 0, 0, 0);
    border-top-width:    0;
    border-left-width:   0;
    border-right-width:  0;
    border-bottom-width: 0;
    color:               rgba(240, 240, 248, 0.90);
    font-size:           14px;
    -unity-font-style:   bold;
    height:              24px;
    padding-top:         0;
    padding-bottom:      0;
    padding-left:        0;
    padding-right:       0;
    cursor:              link;
    transition-property: color;
    transition-duration: 120ms;
}

.pera-footer-link:hover {
    color: #FFFFFF;
}

.pera-footer-link:active {
    color: rgba(240, 240, 248, 0.50);
}


/* ── Store buttons ───────────────────────────────────────────────────── */

.pera-store-btn {
    background-color:           rgba(255, 255, 255, 0.05);
    border-top-width:           1px;
    border-left-width:          1px;
    border-right-width:         1px;
    border-bottom-width:        1px;
    border-top-color:           rgba(255, 255, 255, 0.08);
    border-left-color:          rgba(255, 255, 255, 0.05);
    border-right-color:         rgba(255, 255, 255, 0.05);
    border-bottom-color:        rgba(255, 255, 255, 0.03);
    border-top-left-radius:     11px;
    border-top-right-radius:    11px;
    border-bottom-left-radius:  11px;
    border-bottom-right-radius: 11px;
    color:                      rgba(240, 240, 248, 0.70);
    font-size:                  14px;
    -unity-font-style:          bold;
    height:                     44px;
    min-width:                  143px;
    padding-left:               22px;
    padding-right:              22px;
    padding-top:                0;
    padding-bottom:             0;
    margin-left:                6px;
    margin-right:               6px;
    cursor:                     link;
    transition-property:        background-color, border-color, color;
    transition-duration:        120ms;
}

.pera-store-btn:hover {
    background-color:    rgba(255, 255, 255, 0.10);
    border-top-color:    rgba(255, 255, 255, 0.20);
    border-left-color:   rgba(255, 255, 255, 0.14);
    border-right-color:  rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    color:               rgba(255, 255, 255, 0.95);
}

.pera-store-btn:active {
    background-color: rgba(255, 255, 255, 0.04);
    color:            rgba(240, 240, 248, 0.50);
}
