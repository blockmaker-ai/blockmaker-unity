<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="PeraConnectModal.uss" />

    <ui:VisualElement name="pera-root" class="pera-overlay">
        <ui:VisualElement class="pera-backdrop" />

        <!-- ── Connect Panel ─────────────────────────────────── -->
        <ui:VisualElement name="panel-connect" class="pera-card">

            <ui:Button name="btn-back" class="pera-back-btn" text="">
                <ui:VisualElement class="auth-chevron auth-chevron--left" />
            </ui:Button>
            <ui:Button name="btn-close" class="pera-close-btn" text="">
                <ui:VisualElement class="auth-close-x">
                    <ui:VisualElement class="auth-close-bar auth-close-bar--a" />
                    <ui:VisualElement class="auth-close-bar auth-close-bar--b" />
                </ui:VisualElement>
            </ui:Button>

            <ui:VisualElement name="img-pera-icon" class="pera-logo" />

            <ui:Label class="pera-title" text="Connect Wallet" />

            <ui:VisualElement class="pera-qr-frame">
                <ui:VisualElement name="qr-connect" class="pera-qr" />
            </ui:VisualElement>

            <ui:Label name="lbl-connect-status" class="pera-status" text="Scan with your Pera Wallet" />
            <ui:Label name="lbl-steps-hint" class="pera-steps-hint" text="Signing in takes 2 quick approvals in your wallet." />

            <!-- Step 2 of 2: waiting for the sign-in approval (shown instead of the QR) -->
            <ui:VisualElement name="panel-step2" class="pera-step2 pera-hidden">
                <ui:Label class="pera-step2-badge" text="STEP 2 OF 2" />
                <ui:Label name="lbl-step2-body" class="pera-step2-body" text="Approve the SIGN-IN REQUEST in your wallet app - it's a free signature, nothing leaves your wallet." />
                <ui:VisualElement class="pera-step2-dots">
                    <ui:VisualElement name="pera-step2-dot-1" class="pera-step2-dot" />
                    <ui:VisualElement name="pera-step2-dot-2" class="pera-step2-dot" />
                    <ui:VisualElement name="pera-step2-dot-3" class="pera-step2-dot" />
                </ui:VisualElement>
                <ui:Label class="pera-step2-hint" text="Check your phone - the request is waiting in the app." />
                <ui:Label name="lbl-step2-resend-hint" class="pera-step2-resend-hint" text="Request expired or nothing in your app? Resend it." />
                <ui:Button name="btn-step2-resend" class="pera-store-btn pera-step2-resend-btn" text="RESEND REQUEST" />
                <ui:Button name="btn-step2-cancel" class="pera-step2-cancel-btn" text="CANCEL" />
            </ui:VisualElement>

            <ui:Button name="btn-open-wallet" class="pera-store-btn" text="OPEN IN WALLET APP" style="display: none; margin-bottom: 15px;" />

            <ui:VisualElement class="pera-divider" />

            <ui:VisualElement class="pera-footer">
                <ui:Label name="lbl-footer-hint" class="pera-footer-hint" text="Don&#x2019;t have Pera?" />
                <ui:Button name="btn-show-download" class="pera-footer-link" text="Download &#x2192;" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ── Download Panel ────────────────────────────────── -->
        <ui:VisualElement name="panel-download" class="pera-card pera-hidden">

            <ui:Button name="btn-download-back" class="pera-back-btn" text="">
                <ui:VisualElement class="auth-chevron auth-chevron--left" />
            </ui:Button>
            <ui:Button name="btn-close-dl" class="pera-close-btn" text="">
                <ui:VisualElement class="auth-close-x">
                    <ui:VisualElement class="auth-close-bar auth-close-bar--a" />
                    <ui:VisualElement class="auth-close-bar auth-close-bar--b" />
                </ui:VisualElement>
            </ui:Button>

            <ui:VisualElement name="img-pera-icon-2" class="pera-logo" />

            <ui:Label name="lbl-dl-title" class="pera-title" text="Get Pera Wallet" />

            <ui:VisualElement class="pera-qr-frame pera-qr-frame-sm">
                <ui:VisualElement name="qr-download" class="pera-qr pera-qr-sm" />
            </ui:VisualElement>

            <ui:Label name="lbl-dl-status" class="pera-status" text="Scan to visit perawallet.app" />

            <ui:VisualElement class="pera-divider" />

            <ui:VisualElement class="pera-footer">
                <ui:Button name="btn-ios" class="pera-store-btn" text="App Store" />
                <ui:Button name="btn-android" class="pera-store-btn" text="Google Play" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
